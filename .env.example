# Any OpenAI-compatible endpoint serving an open-weights model.
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1   (LLM_API_KEY can be any string)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-me
LLM_MODEL=qwen/qwen3-32b

# Default approver shown at the approval prompt (synthetic demo name)
OFFICER_NAME=Officer A. Demo

# Optional: extra JSON body sent with every model request (provider-specific).
# Groq + Qwen3, to turn off the long <think> output:  {"reasoning_effort": "none"}
LLM_EXTRA_BODY=
